generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  price     Int
  oldPrice  Int?
  image     String
  genres    String[]
  isTop     Boolean  @default(false)
  createdAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id                Int              @id @default(autoincrement())
  slug              String           @unique
  title             String
  price             Int
  oldPrice          Int?
  image             String
  genres            String[]
  isTop             Boolean          @default(false)
  createdAt         DateTime         @default(now())
  ps4Stock          Int              @default(0)
  ps5Stock          Int              @default(0)
  pricePrimaryPs5   Int?
  pricePrimaryPs4   Int?
  priceSecondaryPs5 Int?
  priceSecondaryPs4 Int?
  priceUkraine      Int?
  priceTurkey       Int?
  inventoryAliases  InventoryAlias[]
}

model InventoryAlias {
  id              Int      @id @default(autoincrement())
  sourceTitle     String   @unique
  normalizedTitle String   @unique
  gameId          Int
  createdAt       DateTime @default(now())
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}
